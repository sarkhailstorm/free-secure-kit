{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/tools/csv-cleaner", "destination": "/tools/spreadsheet-tools", "permanent": true },
    { "source": "/tools/image-compressor", "destination": "/tools/image-tools", "permanent": true },
    { "source": "/tools/background-remover", "destination": "/tools/image-tools", "permanent": true },
    { "source": "/tools/passport-photo", "destination": "/tools/image-tools", "permanent": true },
    {
      "source": "/tools/json-csv-yaml-converter",
      "destination": "/tools/developer-tools",
      "permanent": true
    },
    {
      "source": "/tools/markdown-converter",
      "destination": "/tools/developer-tools",
      "permanent": true
    },
    { "source": "/tools/text-utilities", "destination": "/tools/developer-tools", "permanent": true }
  ],
  "headers": [
    {
      "source": "/models/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/ort/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/qpdf/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/pdf.worker.min.mjs",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
